# His power logger (deploy/powerlog.sh) from every boot, beside fish-brain.
# Installed by deploy/unoq_setup.sh service. The CSV is the record; its stdout is discarded
# so the journal does not get a line every 10 s.
[Unit]
Description=fish_brain - power logger (uptime, USB and sound-card counts every 10 s)

[Service]
ExecStart=%h/fish_brain/deploy/powerlog.sh
Restart=always
RestartSec=5
StandardOutput=null

[Install]
WantedBy=default.target
