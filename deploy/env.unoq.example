# fish_brain settings for the Arduino UNO Q ("segunda").
# `deploy/unoq_setup.sh install` copies this file to ~/fish_brain/.env when none exists.
#
# Format: plain KEY=value. Comments only on their own line. No `export`, no quotes,
# no comment after a value.

# --- keys ---------------------------------------------------------------------------
# Required: speech-to-text, text-to-speech and the luna LLM profile all use it.
OPENAI_API_KEY=
# Only for FISH_LLM_PROFILE=groq or FISH_STT_BACKEND=groq.
GROQ_API_KEY=

# --- motor link ---------------------------------------------------------------------
# The internal UART to the STM32. fish_brain asks arduino-router to release it at start
# and hands it back on exit.
FISH_SERIAL_PORT=/dev/ttyHS1
# serial = raw UART (default). bridge = RPC through arduino-router to a Bridge sketch.
FISH_SERIAL_TRANSPORT=serial
# false = keep talking when the link cannot open (voice only, retried in the background).
FISH_SERIAL_REQUIRED=false
# Set to false only after `deploy/unoq_setup.sh router off` (no router to ask).
FISH_ROUTER_RELEASE=true
# Records every line sent to the MCU and every byte read back. Empty = off.
FISH_LINK_LOG=

# --- speech and LLM -----------------------------------------------------------------
# canary = NVIDIA Canary through sherpa-onnx, on the board: about 2.5 s for a short turn and
# as accurate on the owner's voice as `small`, which takes 20 s
# (docs/results/2026-10-12-unoq-stt-candidates.md; his word, 2026-10-12). local =
# faster-whisper, as on the laptop. openai = upload the recording (about 0.6 s). All can be
# flipped while the fish runs from /debug -> Switches.
FISH_STT_BACKEND=canary
# The Canary model's folder: `deploy/unoq_setup.sh stt` fetches it and prints this line.
FISH_STT_MODEL_DIR=/home/arduino/.cache/fish_brain/stt/sherpa-onnx-nemo-canary-180m-flash-en-es-de-fr-int8
# canary takes recordings up to 6 s (a constant in config.py). A longer one goes to these
# services, in order, while the board is online: groq = whisper-large-v3-turbo, free tier,
# under a second (docs/results/2026-10-13-unoq-stt-his-takes.md). openai is held for the
# fair. Empty = the long ones always stay on the board.
FISH_STT_LONG=groq
# The faster-whisper model: with canary it takes the long recordings when no service
# answers or the board is offline, on a 10 s window (about 10 s for 7 s, 16 to 42 s over 10 s). With local it takes every
# turn, about 20 s.
FISH_STT_MODEL=small
# openai = cloud voice. loq = Loquendo under Wine (only if it passed the timing test).
FISH_TTS_BACKEND=loq
FISH_LOQ_BIN=/home/arduino/.local/bin/loq
# Licence guard (docs/results/2026-10-25-loquendo-licence.md): the probe phrase's clean length
# on this board, the warning's length, and the adapter whose own MAC the licence needs.
FISH_LOQ_PROBE_S=3.01
FISH_LOQ_WARNING_S=4.52
FISH_LOQ_MAC_IFACE=wlan0
FISH_LLM_PROFILE=luna
# Words the cloud speech-to-text should expect: the one-word answers of the reading.
FISH_STT_KEYWORDS=sí,no,me llamo

# --- the reading (ADR 0007): a badge photo becomes "¿Tú eres X?" -------------------
# Profile that reads the badge; empty = FISH_LLM_PROFILE. Only luna takes images.
FISH_READING_PROFILE=
# true = the console shows a consent tick per visitor; with it the fish may mention the
# visitor's clothing, colours or accessories in one kind line. Never without the tick.
FISH_READING_LOOK=true

# --- push-to-talk -------------------------------------------------------------------
# The 2.4 GHz remote (XING WEI): its OK button (KEY_ENTER) is the hold-to-talk trigger and its
# own microphone records. Its voice key reports only a 0.12 s tap, so it cannot be held.
# name:<part of the device name>, a /dev/input path, or auto (every node with the key; auto
# also adopts the headset jack). Find them with:
#   .venv/bin/python -m fish_brain.evdev_button --list
# With FISH_MIC_CAPTURE=browser a remote press makes the phone page record instead, while a
# page has its microphone ready.
FISH_PTT_DEVICE=name:XING WEI
# The microphone: the remote's own (wpctl status: 'USB Composite Device Mono'). The RedOctane
# drew more current than the board gives.
FISH_MIC_SOURCE=alsa_input.usb-XING_WEI_2.4G_USB_USB_Composite_Device-00.mono-fallback
# Several keys separated by commas are one button: this remote sends BTN_LEFT for OK when it
# is in its mouse mode (seen 2026-10-12).
FISH_PTT_KEY=KEY_ENTER,BTN_LEFT
# hold = record while pressed. toggle = one press starts, the next one stops (the XING WEI
# remote sends a fixed 0.12 s tap however long its key is held, measured 2026-10-12).
FISH_PTT_MODE=hold
# Longest hold. 15 s by default (a stuck button); the OK button releases cleanly, so longer.
FISH_PTT_MAX_S=45
# The remote's microphone streams only while its key is physically held: once the stream
# goes dead (exact zeros) for this long after sound, the recording ends by itself, so a turn is
# press, talk, release. 0 = off (measured 2026-10-12).
FISH_PTT_DEAD_S=0
# Tap, talk, stop talking: after this long a pause (chunks under FISH_PTT_QUIET_RMS) the
# recording ends by itself and the fish answers. The remote's room floor is about 0.01 to 0.03,
# speech 0.10 and up (measured 2026-10-12).
FISH_PTT_PAUSE_S=0
FISH_PTT_QUIET_RMS=0.04
# Saying "salir" must not switch the fish off at a public fair.
FISH_VOICE_QUIT=false
# host = the board records (the remote's microphone). browser = the page records with the
# phone's or laptop's microphone and uploads it (needs the https page or the Chrome flag); a
# page without a microphone shows no button and the board records.
FISH_MIC_CAPTURE=host

# --- on-screen fish and web hold-to-talk button --------------------------------------
# 0.0.0.0 = reachable from the phone at http://segunda.local:8723 or http://<board ip>:8723
# (an Android hotspot phone needs the IP form). The page opens in the operator console by default
FISH_VIZ_HOST=0.0.0.0
# Empty on your own password-protected hotspot: the page is then just the address, no token.
# On a network with strangers set one (python3 -c 'import secrets; print(secrets.token_urlsafe(8))')
# and open the page as /?token=<the value>; the phone remembers it after the first open.
FISH_VIZ_TOKEN=
# Requests from the board itself (127.0.0.1: the ssh tunnel, the parked kiosk) need no token.
FISH_VIZ_TRUST_LOCAL=true
# HTTPS: the phone's microphone needs a secure context. With both files set a second
# listener serves the same page at https://<board ip>:8724 (the http one stays).
# Make the files with: deploy/unoq_setup.sh tls <hotspot ip>   (outside the synced tree)
FISH_VIZ_TLS_CERT=/home/arduino/.config/fish_brain/tls/segunda.crt
FISH_VIZ_TLS_KEY=/home/arduino/.config/fish_brain/tls/segunda.key
FISH_VIZ_TLS_PORT=8724
# Parked (ADR 0006): kiosk display mode. Empty = the display's preferred mode. Set 1280x720
# or 1920x1080 if the panel shows "no signal" in its own mode.
FISH_KIOSK_MODE=

# --- behaviour ----------------------------------------------------------------------
# Greet once per boot, not on every service restart.
FISH_WELCOME_ONCE=true
# A recording the fish can use is answered at once with a bubble sound and one chain of
# the tail (a flap or two): "I heard you". No burble = it did not hear the press.
FISH_BURBLE=true
# While a turn waits the fish says a short phrase after 2.5 s of silence, then one every
# 2 s of silence, and at 12 s it says it did not hear well and listens again (ADR 0010).
# false = silent waits and no limit. The phrases are rendered with the others at start.
FISH_FILLER=true
FISH_FILLER_DELAY_S=2.5
FISH_FILLER_GAP_S=2.0
FISH_TURN_TIMEOUT_S=12
# After the welcome, say the last two octets of the board's address ("Búscame en el punto
# 43 punto 17"): the hotspot hands out a different one each session.
FISH_SAY_ADDRESS=true
